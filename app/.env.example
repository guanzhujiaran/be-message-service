# =============================================================================
# be-message-service 环境变量模板
#
# 逐项对应 app/core/config.py 的 Settings 字段（变量名 = 字段名大写，
# pydantic-settings 大小写不敏感），注释里的取值即为 config.py 的默认值。
# 其中推送 / 服务标识等共用项继承自 bili_common.core.push_settings.PushNotifySettingsMixin。
# 用法：cp app/.env.example app/.env，按需覆盖；未覆盖的项自动使用默认值。
# 说明：本地 uv 直跑时以本文件为唯一配置来源；Docker 部署由 dc-dev.yml /
#       docker-compose.yml 的 environment 覆盖同名变量（连接串指向容器服务名）。
# =============================================================================

# ==================== RabbitMQ ====================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/?heartbeat=180
# FastStream（RabbitMQ 消费者 / 发布者）自身日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# 仅影响 FastStream 框架的标准库日志，不影响 loguru 业务日志。
FASTSTREAM_LOG_LEVEL=INFO
# 业务日志（loguru）级别。约定生产只打印 WARNING 及以上，开发设 DEBUG 看全量；只输出到 stderr。
LOG_LEVEL=WARNING
# 运行环境：development / production。
# 仅 development 会把 WARNING 及以上日志额外写入 LOG_FILE_DIR；production 不写日志文件。
APP_ENV=production
# 开发环境日志文件目录（仅 APP_ENV=development 生效）
LOG_FILE_DIR=logs

# ==================== HTTP ====================
# AsgiFastStream 健康检查服务监听地址（暴露 /health）
HTTP_HOST=0.0.0.0
HTTP_PORT=18739

# ==================== MySQL 主库（元数据库）====================
# 系统通知 / 事件提醒 / 私信索引 / 会话 / 设置等表所在库。
# 私信「正文」不落这里，而是按月分库 + 库内 100 张分表（见 app.core.sharding）。
# 库不存在时由 ensure_database() 首次启动自动 CREATE DATABASE。
MYSQL_MESSAGE_URL=mysql+aiomysql://root:root@mysql:3306/BiliMessageDB?charset=utf8mb4
# 私信内容分库名前缀：实际库名为 {prefix}_{YYYYMM}，如 bili_msg_content_202608
DM_CONTENT_DB_PREFIX=bili_msg_content
# 私信内容分表名前缀：实际表名为 {prefix}_{00..99}
DM_CONTENT_TABLE_PREFIX=msg_content
# 单个月度库内的分表数量（msgkey 取余路由）
DM_CONTENT_TABLE_COUNT=100
# 连接池（pool_size + max_overflow 超过 100 会被强制重置为 20/30）
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=15
MYSQL_POOL_RECYCLE=300
MYSQL_ECHO=false

# ==================== pptr Postgres（PPTR_Bili_Lot，已由 be-message 接管）====================
# 该库可读可写，版本演进由独立 Alembic 分支 alembic_pptr/ 管理。
POSTGRES_PPTR_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/PPTR_Bili_Lot
# pptr 用户表所在 schema（sequelize 默认 public）
POSTGRES_PPTR_SCHEMA=public
POSTGRES_PPTR_POOL_SIZE=10
POSTGRES_PPTR_MAX_OVERFLOW=20
POSTGRES_PPTR_POOL_RECYCLE=300
POSTGRES_PPTR_ECHO=false

# ==================== Alembic ====================
# 应用启动时自动执行 alembic upgrade head
ALEMBIC_AUTO_MIGRATE=true
ALEMBIC_UPGRADE_TARGET=head

# ==================== msgkey（雪花 ID）====================
# msgkey 起始纪元（毫秒时间戳）：2024-01-01 00:00:00 UTC+8
MSGKEY_EPOCH_MS=1704038400000
# 本实例 worker 编号（多实例部署时互不相同，0~1023）
MSGKEY_WORKER_ID=1

# ==================== uid（短雪花 ID，分钟步进）====================
# uid epoch（秒级时间戳）：2026-08-08 00:00:00 UTC+8
UID_EPOCH_SEC=1756684800
# uid worker 编号（0~15），多实例部署时互不相同
UID_WORKER_ID=1
# uid 序列号位宽（默认 4 = 每 worker 每分钟 16 个，总位数恒 39 bits）。
# ⚠️ 放宽（如 7）会改变对外 ID 数值空间、可能与已发布 ID 重叠，仅限清库重建环境，生产保持 4。
UID_SEQUENCE_BITS=4

# ==================== moment_id / topic_id（独立短雪花 ID）====================
# 与 uid 使用不同 epoch / worker，避免同一分钟内序列号碰撞。
MOMENT_ID_EPOCH_SEC=1756771200
MOMENT_ID_WORKER_ID=2
# ⚠️ 同 UID_SEQUENCE_BITS，生产保持 4
MOMENT_ID_SEQUENCE_BITS=4
TOPIC_ID_EPOCH_SEC=1756915200
TOPIC_ID_WORKER_ID=3
# ⚠️ 同 UID_SEQUENCE_BITS，生产保持 4
TOPIC_ID_SEQUENCE_BITS=4

# ==================== GeoIP（IP 属地解析）====================
# GeoLite2 mmdb 目录（含 GeoLite2-City.mmdb）。
# 本地开发：默认 ./mmdb，用 scripts/download_geoip_mmdb.py 下载；
# Docker：挂载 docker_vol/geoip/mmdb 到 /app/mmdb。
GEOIP_MMDB_DIR=./mmdb

# ==================== 活跃度 / 定时任务 ====================
# 用户在该秒数内有过行为即视为「活跃用户」（仅用于前端轮询节奏判定）
ACTIVE_USER_WINDOW_SECONDS=300
# 标记已发布系统通知为「已投递」的定时任务间隔（秒）
NOTIFY_DISPATCH_INTERVAL_SECONDS=60
# 是否启用后台定时任务
SCHEDULER_ENABLED=true

# ==================== EdgeRank 推荐排序 ====================
# 总开关：False 时 recommend/hot 回退为时间倒序
EDGERANK_ENABLED=true
# 综合 Feed 半衰期（秒）：默认 24h
EDGERANK_FEED_HALF_LIFE_SECONDS=86400
# 综合 Feed 权重（JSON 对象）
EDGERANK_FEED_WEIGHTS={"like":1.0,"comment":1.5,"repost":2.0,"view":0.1,"favorite":1.2,"share":0.8}
# 话题 Feed 半衰期（秒）：默认 6h
EDGERANK_TOPIC_FEED_HALF_LIFE_SECONDS=21600
# 话题 Feed 权重（JSON 对象）
EDGERANK_TOPIC_FEED_WEIGHTS={"like":1.2,"comment":1.8,"repost":1.5,"view":0.05,"favorite":1.0}
# 话题广场 / 热搜半衰期（秒）：默认 12h
EDGERANK_TOPIC_SQUARE_HALF_LIFE_SECONDS=43200
# 话题广场权重（JSON 对象），话题分 = Σ(w·log(count+1))·decay(pubTime)
EDGERANK_TOPIC_SQUARE_WEIGHTS={"dynCount":1.0,"viewCount":0.6,"isHot":5.0,"sortWeight":2.0}
# 综合 Feed recommend 候选集：最近 N 小时内、上限 M 条
EDGERANK_CANDIDATE_WINDOW_HOURS=72
EDGERANK_CANDIDATE_LIMIT=300
# ---- 个性化（登录用户）：score = base + Σ(w_personal·signal) ----
EDGERANK_PERSONALIZED_ENABLED=true
# 关注作者（最强）
EDGERANK_PERSONALIZED_FOLLOW_WEIGHT=3.0
# 点赞过的作者（关注冷启动补充）
EDGERANK_PERSONALIZED_LIKED_AUTHOR_WEIGHT=1.5
# 互动过的话题
EDGERANK_PERSONALIZED_TOPIC_WEIGHT=1.2
# 点赞历史回看条数（信号来源上限；0 表示不加载点赞/话题信号）
EDGERANK_PERSONALIZED_LIKE_HISTORY_LIMIT=200
# ---- 匿名随机化（未登录用户按 uniq_id 派生扰动权重，每项 × [1±ratio]）----
EDGERANK_ANON_RANDOMIZE_ENABLED=true
EDGERANK_ANON_PERTURB_RATIO=0.3
# ---- 多维打分 ----
# 互动率 (like+comment+repost)/max(view,1)，防僵尸爆款
EDGERANK_ENGAGEMENT_WEIGHT=0.5
# 内容丰富度（contentJson 含图片/视频/LINK 节点）
EDGERANK_RICH_WEIGHT=0.4
# FORWARD 转发惩罚（负权重）
EDGERANK_FORWARD_PENALTY=-0.6
# fresh_bonus = w/(1+viewCount)：新内容冷启动
EDGERANK_FRESH_WEIGHT=1.0
# feedback：点踩降权 = -w·dislike_ratio（对所有人略降）
EDGERANK_DISLIKE_PENALTY=2.0
# ---- 点踩个人化降权（对点踩者本人大幅降权，受 EDGERANK_PERSONALIZED_ENABLED 兜底）----
EDGERANK_PERSONAL_DISLIKE_ENABLED=true
# 比例压制（0~1）：高分内容同样显著下沉（默认 0.3 → 保留三成）
EDGERANK_PERSONAL_DISLIKE_SCALE=0.3
# 固定扣分：中等分数内容直接沉底（远大于正向 boost 3.0）
EDGERANK_PERSONAL_DISLIKE_WEIGHT=5.0
# True 时点踩过的资源直接剔除出该观众 Feed；默认 False（仅排序靠后）
EDGERANK_PERSONAL_DISLIKE_EXCLUDE=false
# 登录用户 last_clicklist 已互动作者/话题加权
EDGERANK_CLICK_WEIGHT=1.0
# author_signal：作者质量（moment_author_quality.avgEngagement）
EDGERANK_AUTHOR_QUALITY_WEIGHT=0.8
# 近 7 天发布量每超过该阈值 1 条惩罚分
EDGERANK_AUTHOR_PUBLISH_THRESHOLD=5
EDGERANK_AUTHOR_SPAM_PENALTY=0.2
# 举报数降权（每 1 条 pending 举报扣分，按 bizType+bizId 统计）
EDGERANK_REPORT_PENALTY=0.5
# 作者粉丝数 log(1+fans)
EDGERANK_FANS_WEIGHT=0.2
# 作者等级 currentLevel
EDGERANK_LEVEL_WEIGHT=0.1
# 时间衰减基准改用「最近活跃时间」（max(pubTime, 最后评论时间)）；关闭则仅用发布时间
EDGERANK_DECAY_USE_LAST_ACTIVITY=true
# ---- 候选集多路召回（并集去重，仍受 EDGERANK_CANDIDATE_LIMIT 总上限约束）----
# 热门/趋势路：时间窗口最新 + 互动 top 兜底
EDGERANK_RECALL_HOT_ENABLED=true
EDGERANK_RECALL_HOT_LIMIT=200
EDGERANK_RECALL_HOT_TOP_LIMIT=100
# 社交关系路：关注作者动态（未登录跳过）
EDGERANK_RECALL_SOCIAL_ENABLED=true
EDGERANK_RECALL_SOCIAL_LIMIT=100
# 内容标签/分类路：偏好话题动态（未登录跳过）
EDGERANK_RECALL_TOPIC_ENABLED=true
EDGERANK_RECALL_TOPIC_LIMIT=100
# 地理位置路：附近动态（需请求带 lat/lng）
EDGERANK_RECALL_GEO_ENABLED=true
EDGERANK_RECALL_GEO_LIMIT=50
EDGERANK_RECALL_GEO_RADIUS_KM=50.0
# 协同过滤路（MVP 近似）：点赞/互动过作者的新动态
EDGERANK_RECALL_CF_ENABLED=true
EDGERANK_RECALL_CF_LIMIT=100
# ---- Feed 曝光去重（推荐流已下发资源记入 TFeedImpression，TTL 内不再重复下发）----
EDGERANK_DEDUP_ENABLED=true
# 曝光记录有效期（小时）
EDGERANK_DEDUP_IMPRESSION_TTL_HOURS=24
# 单次查询曝光记录的最大 id 数（防超大 IN 查询）
EDGERANK_DEDUP_QUERY_LIMIT=2000

# ==================== 私信策略 ====================
# 消息可撤回的时间窗口（秒）
DM_RECALL_WINDOW_SECONDS=120
# 会话列表 / 消息列表默认页大小
DM_DEFAULT_PAGE_SIZE=20
# 私信内容异步落库失败时是否降级为同步写入
DM_CONTENT_SYNC_FALLBACK=true
# 单用户每自然日可发送私信总量上限（0 表示不限制）
DM_DAILY_SEND_LIMIT=1000
# 陌生人单条闸门开关：对方未关注我且从未回过我消息时，我仅可发陌生人单条额度
DM_STRANGER_GATE_ENABLED=true
DM_STRANGER_GATE_LIMIT=1
# 私信发布模式：true = 先审后发（对接收方不可见，审核通过才可见）
DM_PRE_AUDIT=false

# ==================== 内容发布每日上限（0 表示不限制）====================
# ⚠️ seed / 全互动联调环境可调大放开灌数，生产请用默认值。
# 单用户每自然日可创建评论数上限（超限业务码 4101）
COMMENT_DAILY_CREATE_LIMIT=100
# 单用户每自然日可创建 (WORD) 动态数上限，FORWARD 不计（超限业务码 4102）
MOMENT_DAILY_CREATE_LIMIT=30
# 单用户每自然日可创建话题数上限（超限业务码 4103）
TOPIC_DAILY_CREATE_LIMIT=10

# ==================== 评论系统 ====================
# 单条评论最多携带的图片数（对齐 B 站九宫格）
COMMENT_PICTURE_MAX=9
# 图片 URL 域名白名单（JSON 数组）；**留空表示不限制**
COMMENT_PICTURE_DOMAINS=[]
# 单条评论最多 @ 的人数
COMMENT_AT_MAX=10
# 评论正文最大长度（与原 Node 端 TComment.content 的 4096 对齐）
COMMENT_MESSAGE_MAX_LENGTH=4096
# 评论列表默认页大小
COMMENT_DEFAULT_PAGE_SIZE=20
# 一级评论下内嵌展示的楼中楼预览条数
COMMENT_SUB_PREVIEW_COUNT=3
# 评论发布模式：true = 所有原可直接展示的评论一律先进入审核态（仅作者可见）
COMMENT_PRE_AUDIT=false
# 单条评论累计有效举报数达该值 → normal 转 auditing 待管理员复核
COMMENT_REPORT_THRESHOLD=3
# 运行时配置（msg_sys_config）进程内缓存 TTL（秒）；0 = 不缓存（每次读主库）
SYS_CONFIG_CACHE_TTL_SECONDS=10
# 统一举报达阈值转审核（动态 / 用户空间）
REPORT_THRESHOLD=3
# 评论频率限制规则（JSON 数组），空数组 = 关闭该档限流。
# 运行时以 msg_sys_config['comment_rate_limit'] 覆盖（管理端热更新），此处仅为代码默认值。
# 每条规则形如 {"window_seconds":10,"max_count":3,"same_content":true}
COMMENT_RATE_ROOT_RULES=[{"window_seconds":10,"max_count":2,"same_content":true},{"window_seconds":10,"max_count":3},{"window_seconds":60,"max_count":15}]
COMMENT_RATE_REPLY_RULES=[{"window_seconds":10,"max_count":3,"same_content":true},{"window_seconds":10,"max_count":6},{"window_seconds":60,"max_count":30}]

# ==================== pptr 用户成长等级 ====================
# 最高等级
LEVEL_MAX_LEVEL=6
# 每日首次登录奖励经验值
LEVEL_DAILY_EXP_BONUS=3
# 各等级升级所需的「累积经验值」（JSON 对象，键为等级）
LEVEL_EXP_REQUIREMENTS={"1":1000,"2":5000,"3":20000,"4":80000,"5":288000,"6":999999999}
# 各角色（等级 / 管理员）展示文案（JSON 对象），对齐 pptr user_role_const.getRoleDescription
LEVEL_ROLE_DESCRIPTION={"level0":"普通用户 (Lv0)","level1":"普通用户 (Lv1)","level2":"普通用户 (Lv2)","level3":"普通用户 (Lv3)","level4":"普通用户 (Lv4)","level5":"普通用户 (Lv5)","level6":"普通用户 (Lv6)","root":"系统管理员"}

# ==================== JWT（用户网关下沉 be-message）====================
# 必须与 pptr 侧 JwtModule.js 的 secretKey 保持一致
JWT_SECRET=关注永雏塔菲喵，关注永雏塔菲谢谢喵！114514
JWT_ALGORITHM=HS256
# 默认 15 天
JWT_EXPIRES_SECONDS=1296000

# ==================== 前端地址（Casdoor 回调重定向）====================
FRONTEND_URL=

# ==================== Casdoor（用户网关下沉 be-message）====================
CASDOOR_ENABLED=false
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=
CASDOOR_APPLICATION=
CASDOOR_SERVICE=
# 证书：整段 PEM 压成一行，换行用字面 \n 表示（启动时自动还原为真实换行）
CASDOOR_CERTIFICATE=
# 管理员账号（password grant 换 admin token 查询用户信息）。
# Casdoor 若开启「不公开账户信息」，service 模式查不到用户，必须用管理员 token 查询。
# 注意：admin 走内置 application「app-built-in」，clientId / clientSecret 与普通登录应用不同。
CASDOOR_ADMIN_NAME=
CASDOOR_ADMIN_PASSWORD=
CASDOOR_ADMIN_CLIENT_ID=
CASDOOR_ADMIN_CLIENT_SECRET=
CASDOOR_ADMIN_APPLICATION=app-built-in

# ==================== 推送渠道 ====================
# pushme / pushplus 渠道默认端点
PUSHME_URL=https://push.i-i.me
PUSHPLUS_URL=http://www.pushplus.plus/send
# 全局渠道配置：单个 JSON 环境变量，与 be-bilibili-crawler / rpa-browser 共用同一份，
# 作为无 per-user 配置时的全局兜底。类型为 bili_common.models.push.PushChannelConfig，
# 完整字段见该模型；只填需要启用的渠道即可，凭证为空则该渠道静默跳过。
# ⚠️ 用单引号包裹整段 JSON，避免内部双引号被 shell 截断。
MESSAGE_CONFIG='{"hitokoto":false,"pushme_key":"","pushme_url":"https://push.i-i.me","push_plus_token":"","push_plus_url":"http://www.pushplus.plus/send","smtp_server":"","smtp_ssl":"false","smtp_email":"","smtp_password":"","smtp_name":"","tg_bot_token":"","tg_user_id":"","tg_api_host":"","tg_proxy_host":"","tg_proxy_port":""}'

# ==================== 共用项（继承自 PushNotifySettingsMixin）====================
# 字段定义单一来源在 bili-common，与 RPA-Browser / be-bilibili-crawler 同构。
# 以下三项 message-service 自身不读取（服务标识 / 一言分别由 crawler、rpa-browser 使用），
# 保留在此是为了三端配置模板一致、便于对照排查。
SERVER_NAME=
SERVER_ADDRESS=
HITOKOTO_API_URL=https://v1.hitokoto.cn
