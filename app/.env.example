# ===== RabbitMQ 连接 =====
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/?heartbeat=180

# ===== MySQL 主库（消息系统元数据库，仅此一个，不用 Redis） =====
# 私信「正文」不落这里，而是按月分库 + 库内 100 表（见 app.core.sharding），由运行时懒创建。
# 首次启动会由 ensure_database() 自动 CREATE DATABASE（库名取自连接串中的 BiliMessageDB）。
MYSQL_MESSAGE_URL=mysql+aiomysql://root:${MYSQL_PASSWORD}@mysql:3306/BiliMessageDB?charset=utf8mb4

# ===== 可选：出网代理（部分推送渠道需要，留空则不走代理） =====
PROXY_SERVER=

# ===== 推送渠道全局配置（JSON，单个环境变量）=====
# FastapiApp / RPA-Browser / notify-service 在 docker-compose 中通过同一个
# NOTIFY_CONFIG 环境变量共用这一份内容，避免维护多份变量。
# 字段与 NotificationConfig 一致（pushme_key / push_plus_token / smtp_* / tg_* 等），
# 只填需要启用的渠道即可；pushme_url / push_plus_url 可省略（使用默认端点）。
#
# 注意：.env 中请用单引号包裹整段 JSON，避免内部双引号/特殊字符被截断。
MESSAGE_CONFIG='{"pushme_key":"","pushme_url":"https://push.i-i.me","push_plus_token":"","push_plus_url":"http://www.pushplus.plus/send","smtp_server":"","smtp_ssl":"false","smtp_email":"","smtp_password":"","smtp_name":"","tg_bot_token":"","tg_user_id":"","tg_api_host":"","tg_proxy_host":"","tg_proxy_port":""}'

# ===== 时区 =====
TZ=Asia/Shanghai
